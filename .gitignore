# SDK build artifacts
sdks/**/target/
sdks/**/node_modules/
sdks/**/.venv/

# The SCIM conformance suite's interpreter. `scim_conformance_e2e_pg.rs` tells you to
# create it here (`uv venv .scim`), so following the repository's own instructions used
# to leave an untracked virtualenv at the root — one `git add -A` from a large binary
# directory in history (#1172).
.scim/
sdks/**/dist/
composer-setup.php
.phpunit.cache/
.phpunit.result.cache
# Studio frontend dependencies (rebuilt by build.rs)
crates/fraiseql-server/studio/node_modules/
# Federation compose-check deps (restored via `npm ci` from the committed lockfile)
tools/federation/node_modules/
tools/tus-interop/node_modules/

# Local TLS test fixtures, regenerated by docker/tls/gen-certs.sh (make db-up).
docker/tls/certs/

# Dart SDK build artifacts
.dart_tool/
sdks/official/fraiseql-dart/pubspec.lock

# Stray cargo target dirs from `cargo --target-dir` typos (#735: an 889-file
# `target-user/` sat invisible in the tree because only *.so was ignored)
/target-*/

# php-cs-fixer's incremental cache (#1238). The *config* next to it is tracked —
# without one the fixer writes a default and exits 0, checking nothing.
.php-cs-fixer.cache
