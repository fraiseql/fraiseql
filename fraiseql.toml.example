# fraiseql.toml: project configuration template
#
# Copy to fraiseql.toml in your project root, beside the schema.json your SDK exports.
# `fraiseql compile schema.json` and `fraiseql run` read it from there.
#
# Every table and key below is one the loader accepts; any other is refused when the file
# is read, naming the key. A setting written `#key = value` (no space after the `#`) is
# left at its default: remove the `#` to set it. Values shown live are the defaults.
#
# `${VAR}` anywhere in the file is replaced by that environment variable when the file is
# read; an unset variable is left as written.
#
# The server's own settings (OIDC, request limits, and anything else `fraiseql-server`
# reads) live in the server configuration file that FRAISEQL_CONFIG names, not here. See
# "Config-Driven Runtime" in docs/architecture/overview.md.

# =============================================================================
# PROJECT
# =============================================================================

[project]
name = "my-fraiseql-app"
version = "1.0.0"
#description = "My GraphQL API"
#database_target = "postgresql"         # PostgreSQL is the only backend; anything else is refused

# =============================================================================
# DATABASE (`fraiseql run`)
# =============================================================================

[database]
#url = "${DATABASE_URL}"
pool_min = 2
pool_max = 20
connect_timeout_ms = 5000               # Connection acquisition timeout
#ssl_mode = "require"                   # disable | prefer | require | verify-full; unset: the URL's ?sslmode=

# =============================================================================
# HTTP SERVER (`fraiseql run`)
# =============================================================================

[server]
host = "0.0.0.0"
port = 8080

[server.cors]
# Each origin a browser app is served from, e.g. ["https://app.example.com"].
# Empty allows http://localhost:3000 only, and the server refuses to start in production
# with an empty list. "*" is refused: list the origins.
origins = []

[server.tls]
enabled = false
cert_file = ""                          # PEM certificate (required when enabled)
key_file = ""                           # PEM private key (required when enabled)
min_version = "1.2"                     # "1.2" or "1.3"

# =============================================================================
# COMPILER
# =============================================================================

[fraiseql]
schema_file = "schema.json"
output_file = "schema.compiled.json"

[fraiseql.naming]
convention = "camelCase"                # camelCase | preserve (keep the names as authored)
acronyms = []                           # Added to the built-in acronyms, e.g. ["SKU"]

[fraiseql.mutations]
auto_error_union = false                # Synthesize a shared MutationError type for every mutation

# Per-operation @cost weight overrides, keyed by operation name.
[fraiseql.cost_weights]
#searchProducts = 5

# =============================================================================
# TENANCY
# =============================================================================

[fraiseql.tenancy]
mode = "none"                           # none | row | schema
tenant_claim = "tenant_id"              # JWT claim that carries the tenant

# =============================================================================
# SESSION VARIABLES
# =============================================================================

# PostgreSQL settings set on each request's transaction.
[fraiseql.session_variables]
inject_started_at = true                # Set fraiseql.started_at on each mutation
# source: jwt (claim), enrichment (field), literal (value), or header (header).
# A header is sent by the client: never use one for row-level security or tenant scoping.
#variables = [{ name = "app.tenant_id", source = "jwt", claim = "tenant_id" }]

# =============================================================================
# SECURITY
# =============================================================================

[fraiseql.security]
multi_tenant = false                    # Implied by a tenancy mode other than "none"
#default_role = "viewer"                # Role of an authenticated caller with none

# Roles and the scopes they grant.
#[[fraiseql.security.role_definitions]]
#name = "admin"
#description = "Full access"
#scopes = ["admin:*"]

# Machine service accounts, keyed by name. The secret is read from the environment.
#[fraiseql.security.service_accounts.reconciler]
#secret_env = "FRAISEQL_SA_RECONCILER_SECRET"
#roles = ["reconciler"]
#scopes = ["write:Invoice"]

[fraiseql.security.audit_logging]
enabled = true

[fraiseql.security.error_sanitization]
enabled = true

[fraiseql.security.rate_limiting]
enabled = true
requests_per_second = 100               # Per client IP, on the GraphQL surface
burst_size = 500
# Read the client IP from X-Real-IP / X-Forwarded-For. Production refuses it with no
# trusted_proxy_cidrs: only a listed proxy may set those headers.
trust_proxy_headers = false
trusted_proxy_cidrs = []                # e.g. ["10.0.0.0/8"]
# A memory ceiling, not a security control: about 200 bytes a bucket, so about 20 MiB per
# map. Reaching it evicts the least-recently-used bucket; it never refuses a new client.
# FRAISEQL_RATE_LIMIT_MAX_BUCKETS overrides it.
max_buckets = 100000
auth_start_max_requests = 100           # Auth endpoint limits, per window
auth_start_window_secs = 60
auth_callback_max_requests = 50
auth_callback_window_secs = 60
auth_refresh_max_requests = 10
auth_refresh_window_secs = 60
auth_logout_max_requests = 20
auth_logout_window_secs = 60
failed_login_max_requests = 10
failed_login_window_secs = 900

# Encrypts PKCE OAuth state. The 32-byte hex key is read from STATE_ENCRYPTION_KEY
# (generate one with `openssl rand -hex 32`).
[fraiseql.security.state_encryption]
enabled = false
algorithm = "chacha20-poly1305"         # chacha20-poly1305 | aes-256-gcm

[fraiseql.security.constant_time]
enabled = true
apply_to_jwt = true
apply_to_session_tokens = true
apply_to_csrf_tokens = true
apply_to_refresh_tokens = true

# Declares that PostgreSQL Row-Level Security isolates this schema's data; checked
# against the database's catalog when the server starts.
[fraiseql.security.rls]
enabled = false

# =============================================================================
# INJECTED PARAMETERS
# =============================================================================

# Parameters every query and mutation receives from the caller's identity.
#[inject_defaults]
#tenant_id = "jwt:tenant_id"

# =============================================================================
# REQUEST LOCALE
# =============================================================================

# See docs/features/request-locale.md.
#[locale]
#default = "en-US"
#allowed = ["en-US", "fr-FR"]
#fallback = { "fr-CA" = "fr-FR" }

# =============================================================================
# FUNCTIONS
# =============================================================================

# The operational half of the functions surface; the functions themselves are declared in
# your SDK. Setting this table when the schema declares no function and no enabled source
# fails the compile: nothing would use it.
#[functions]
#module_dir = "functions"               # Where the .wasm / .js / .ts modules live
#dlq_store = "postgres"                 # memory (the default; lost on restart) | postgres
                                        # FRAISEQL_FUNCTIONS_DLQ_STORE overrides it

# =============================================================================
# OBSERVERS
# =============================================================================

# The server tunes observers under [observers.runtime] in its own configuration file.
#[observers]
#enabled = true
#backend = "nats"                       # postgres (the default) | nats
#nats_url = "nats://localhost:4222"     # Required with nats; FRAISEQL_NATS_URL overrides it
