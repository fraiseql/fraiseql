# Copy to `.env` beside docker-compose.yml. Compose reads it automatically.
#
# All three are REQUIRED. docker-compose.yml declares each as `${VAR:?...}`, so an
# unset one aborts `docker compose up` with an instruction — rather than starting a
# container that exits, which is what every stack deleted on 2026-08-28 did.

# The database password. No default: a default password is a vulnerability.
DB_PASSWORD=

# Host path to your compiled schema — `fraiseql compile schema.json`. The image
# bakes none, and the server exits at startup when FRAISEQL_SCHEMA_PATH names no
# file. Must be a file that EXISTS: Docker creates a DIRECTORY for a missing
# bind-mount source and mounts that.
FRAISEQL_SCHEMA_FILE=

# Host path to your fraiseql.toml. Production mode is the DEFAULT (anything but
# FRAISEQL_ENV=development), and it refuses to start with CORS enabled and no
# origins — `cors_origins` has no environment variable, so it can only arrive in
# this file. The minimum that satisfies it:
#
#     cors_origins = ["https://app.example.com"]
FRAISEQL_CONFIG_FILE=

# OPTIONAL. The HOST side of each published port; the container sides are fixed at
# 8000 and 5432. Set these only when something else on the host already holds one.
#FRAISEQL_HOST_PORT=8000
#FRAISEQL_DB_HOST_PORT=5432
